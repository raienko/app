    "expo-constants": "57.0.13",
    "expo-dev-client": "57.0.14",
    "expo-device": "57.0.1",
    "expo-font": "57.0.1",
    "expo-glass-effect": "57.0.1",
    "expo-image": "57.0.3",
    "expo-image-picker": "~57.0.15",
    "expo-linking": "57.0.7",
    "expo-localization": "57.0.1",
    "expo-notifications": "~57.0.16",
    "expo-observe": "57.0.17",
    "expo-router": "57.0.15",
    "expo-splash-screen": "57.0.7",
    "expo-status-bar": "57.0.1",
    "expo-symbols": "57.0.2",
    "expo-system-ui": "57.0.2",
    "expo-web-browser": "57.0.2",
    "libphonenumber-js": "1.13.12",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "2.32.0",
    "react-native-mmkv": "4.3.2",
    "react-native-nitro-modules": "0.36.5",
    "react-native-reanimated": "4.5.1",
    "react-native-reanimated-carousel": "5.1.1",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.2",
    "react-native-svg": "15.15.4",
    "react-native-ui-datepicker": "3.3.0",
    "react-native-web": "0.21.2",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@gorhom/bottom-sheet": "5.2.14",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-community/slider": "5.2.0",
    "@react-native/jest-preset": "0.86.2",
    "@secretlint/secretlint-rule-aws": "13.0.4",
    "@secretlint/secretlint-rule-basicauth": "13.0.4",
    "@secretlint/secretlint-rule-gcp": "13.0.4",
    "@secretlint/secretlint-rule-github": "13.0.4",
    "@secretlint/secretlint-rule-no-dotenv": "13.0.4",
    "@secretlint/secretlint-rule-npm": "13.0.4",
    "@secretlint/secretlint-rule-privatekey": "13.0.4",
    "@secretlint/secretlint-rule-slack": "13.0.4",
    "@storybook/addon-ondevice-actions": "10.5.4",
    "@storybook/addon-ondevice-controls": "10.5.4",
    "@storybook/react-native": "10.5.4",
    "@storybook/react-native-web-vite": "10.5.10",
    "@testing-library/react-native": "14.0.1",
    "@types/events": "3.0.3",
    "@types/jest": "29.5.14",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "9.39.5",
    "eslint-config-expo": "57.0.1",
    "expo-atlas": "0.4.3",
    "globals": "16.5.0",
    "husky": "9.1.7",
    "jest": "29.7.0",
    "jest-expo": "57.0.4",
    "lint-staged": "17.3.0",
    "patch-package": "8.0.1",
    "prettier": "3.9.6",
    "secretlint": "13.0.4",
    "storybook": "10.5.10",
    "test-renderer": "1.2.0",
    "typescript": "6.0.3",
    "vite": "8.2.2"
  },
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "atlas": "EXPO_ATLAS=true expo start",
    "atlas:export": "EXPO_ATLAS=true expo export",
    "atlas:open": "expo-atlas .expo/atlas.jsonl",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "jest --silent",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "secretlint": "secretlint \"**/*\"",
    "postinstall": "patch-package",
    "prepare": "cd \"$(git rev-parse --show-toplevel)\" && node core/node_modules/husky/bin.js core/.husky",
    "storybook": "STORYBOOK_ENABLED=true expo start",
    "storybook:ios": "STORYBOOK_ENABLED=true expo start --ios",
    "storybook:android": "STORYBOOK_ENABLED=true expo start --android",
    "storybook:web": "storybook dev -p 6006 -c .storybook",
    "storybook:web:build": "storybook build -c .storybook"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "<rootDir>/jest.setup.js"
    ],
    "resolver": "react-native-worklets/jest/resolver.js"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,md}": [
      "prettier --write"
    ],
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix"
    ],
    "**/*": [
      "secretlint"
    ]
  }
}
