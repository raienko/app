# Required:

EXPO_PUBLIC_APP_NAME=core
EXPO_PUBLIC_APP_SLUG=core
EXPO_PUBLIC_APP_SCHEME=core
EXPO_PUBLIC_APP_BUNDLE_ID=com.example.core

# 3- or 6-digit hex, and the quotes are required: an unquoted # starts a
# comment, so the value would be read as empty. Baked into the native
# projects at prebuild — the Android adaptive icon's plate and the splash.
EXPO_PUBLIC_BRAND_ICON_BACKGROUND="#E6F4FE"
EXPO_PUBLIC_BRAND_SPLASH_BACKGROUND="#208AEF"

# Optional:

EXPO_PUBLIC_EAS_PROJECT_ID=0
EXPO_PUBLIC_APP_LINK_DOMAINS=''
