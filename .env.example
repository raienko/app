# Required:

EXPO_PUBLIC_APP_NAME=app
EXPO_PUBLIC_APP_SLUG=app
EXPO_PUBLIC_APP_SCHEME=app
EXPO_PUBLIC_APP_BUNDLE_ID=com.example.app

# 3- or 6-digit hex, and the quotes are required: an unquoted # starts a
# comment, so the value would be read as empty. Baked into the native
# projects at prebuild — the Android adaptive icon's plate and the splash.
EXPO_PUBLIC_BRAND_ICON_BACKGROUND="#E6F4FE"
EXPO_PUBLIC_BRAND_SPLASH_BACKGROUND="#208AEF"

# Optional:

EXPO_PUBLIC_EAS_PROJECT_ID=0
EXPO_PUBLIC_APP_LINK_DOMAINS=''

# Map tiles — optional. Leave both unset to use OpenFreeMap
# (https://openfreemap.org): free, no account or key, OpenStreetMap data.
#
# EXPO_PUBLIC_MAP_TILES_URL — TileJSON URL of a vector tile source in the
#   OpenMapTiles schema (the app draws its own themed style on top of it).
# EXPO_PUBLIC_MAP_GLYPHS_URL — label-font URL template; must contain
#   {fontstack} and {range}, and serve "Noto Sans Regular".
#
# Both must be https. They are public, like every EXPO_PUBLIC_ value: a key in
# them ships inside the app, so restrict it on the provider's side to this
# app's bundle id and web domains. MapTiler's free tier, for example:
#
# EXPO_PUBLIC_MAP_TILES_URL='https://api.maptiler.com/tiles/v3-openmaptiles/tiles.json?key=YOUR_MAPTILER_KEY'
# EXPO_PUBLIC_MAP_GLYPHS_URL='https://api.maptiler.com/fonts/{fontstack}/{range}.pbf?key=YOUR_MAPTILER_KEY'
